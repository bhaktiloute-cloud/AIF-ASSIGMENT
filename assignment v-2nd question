import random

# Step 1: Define chromosome length
chromosome_length = 5

# Step 2: Generate random chromosome
def generate_chromosome():
    return ''.join(
        random.choice('01')
        for _ in range(chromosome_length)
    )

# Step 3: Generate initial population
population_size = 6

population = [
    generate_chromosome()
    for _ in range(population_size)
]

# Step 4: Decode binary chromosome
def decode(chromosome):
    return int(chromosome, 2)

# Step 5: Calculate fitness
def fitness(x):
    return x ** 2

# Step 6: Display population and fitness values
print("INITIAL POPULATION")
print("------------------")

for i, chromosome in enumerate(population):

    x = decode(chromosome)
    fit = fitness(x)

    print("Chromosome:", chromosome)
    print("Decoded Value:", x)
    print("Fitness Value:", fit)
    print("------------------")

# Step 7: Find best chromosome
best = max(population, key=lambda c: fitness(decode(c)))

print("\nBEST CHROMOSOME:", best)
print("BEST VALUE:", decode(best))
print("MAXIMUM FITNESS:", fitness(decode(best)))
